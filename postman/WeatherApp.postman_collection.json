{
  "info": {
    "name": "WeatherApp - OpenWeather",
    "description": "Collection simple pour tester l'API OpenWeather utilisée par WeatherApp (current weather + forecast).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.openweathermap.org/data/2.5"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "city",
      "value": "Paris"
    }
  ],
  "item": [
    {
      "name": "Current Weather",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/weather?q={{city}}&appid={{api_key}}&units=metric&lang=fr",
          "host": ["{{base_url}}"],
          "path": ["weather"],
          "query": [
            { "key": "q", "value": "{{city}}" },
            { "key": "appid", "value": "{{api_key}}" },
            { "key": "units", "value": "metric" },
            { "key": "lang", "value": "fr" }
          ]
        },
        "description": "Récupère la météo actuelle d'une ville (température, description, humidité, etc.)."
      }
    },
    {
      "name": "Forecast",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/forecast?q={{city}}&appid={{api_key}}&units=metric&lang=fr",
          "host": ["{{base_url}}"],
          "path": ["forecast"],
          "query": [
            { "key": "q", "value": "{{city}}" },
            { "key": "appid", "value": "{{api_key}}" },
            { "key": "units", "value": "metric" },
            { "key": "lang", "value": "fr" }
          ]
        },
        "description": "Récupère les prévisions météo sur 5 jours (par tranches de 3h) pour une ville."
      }
    }
  ]
}
